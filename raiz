<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Herrera Soto — Abogados y Asociados</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#000000;
    --ink-soft:#141414;
    --paper:#0b0b0b;
    --paper-dim:#161616;
    --charcoal:#f2e7c9;
    --slate:#b9a262;
    --brass:#c9a227;
    --brass-dim:#e6c877;
    --line:#3a3226;
    --line-dark:#8a6d1f;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--charcoal);
    font-family:'Inter',system-ui,sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{
    font-family:'Fraunces',Georgia,serif;
    font-weight:500;
    letter-spacing:-0.01em;
    color:var(--charcoal);
    margin:0;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 32px;}
  .overflow-x{overflow-x:auto;}

  /* ---------- header ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:var(--paper);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:20px 32px; max-width:1120px; margin:0 auto;
  }
  .brand{
    font-family:'Fraunces',serif; font-size:1.15rem; font-weight:500;
    display:flex; align-items:baseline; gap:8px;
  }
  .brand small{font-family:'Inter',sans-serif; font-size:0.62rem; color:var(--brass); font-weight:600; letter-spacing:.03em;}
  nav.links{display:flex; gap:34px; font-size:0.92rem;}
  nav.links a{text-decoration:none; color:var(--charcoal); position:relative; padding-bottom:4px;}
  nav.links a:hover{color:var(--brass);}
  .btn{
    display:inline-block; background:var(--ink); color:var(--charcoal);
    padding:12px 22px; text-decoration:none; font-size:0.9rem; font-weight:500;
    border-radius:var(--radius); border:1px solid var(--line-dark);
    transition:background .2s ease, color .2s ease;
  }
  .btn:hover{background:var(--brass); border-color:var(--brass); color:#000;}
  .btn-outline{
    background:transparent; color:var(--charcoal); border:1px solid var(--line-dark);
  }
  .btn-outline:hover{background:var(--charcoal); color:var(--paper); border-color:var(--charcoal);}
  .menu-toggle{display:none; background:none; border:none; cursor:pointer; padding:6px;}
  .menu-toggle span{display:block; width:22px; height:2px; background:var(--charcoal); margin:5px 0;}

  /* ---------- hero ---------- */
  .hero{
    background:var(--ink); color:var(--paper);
    padding:96px 0 80px;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{display:grid; grid-template-columns:1.3fr 0.9fr; gap:60px; align-items:end;}
  .hero-kicker{color:var(--brass-dim); font-size:0.85rem; font-weight:500; margin-bottom:18px;}
  .hero h1{
    font-size:clamp(2.4rem, 4.6vw, 3.6rem);
    color:#f4f1e8;
    line-height:1.08;
  }
  .hero p.lede{
    margin-top:22px; max-width:46ch; color:#d9cdb3; font-size:1.06rem;
  }
  .hero-actions{margin-top:34px; display:flex; gap:16px; flex-wrap:wrap;}
  .hero-actions .btn-outline{border-color:#8a6d3a; color:#e9e6dd;}
  .hero-actions .btn-outline:hover{background:#e9e6dd; color:var(--ink);}
  .hero-figure{
    border-left:1px solid #6b5327; padding-left:32px;
  }
  .hero-figure .num{font-family:'Fraunces',serif; font-size:2.6rem; color:var(--brass-dim);}
  .hero-figure .lab{font-size:0.85rem; color:#c9b98a; margin-top:4px; max-width:22ch;}
  .hero-figure + .hero-figure{margin-top:30px;}

  /* ---------- intro / marquee stat strip ---------- */
  .strip{
    border-bottom:1px solid var(--line);
    padding:26px 0;
  }
  .strip .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px; font-size:0.88rem; color:var(--slate);}
  .strip strong{color:var(--charcoal); font-family:'Fraunces',serif; font-weight:500; font-size:1.05rem;}

  /* ---------- sections generic ---------- */
  section{padding:88px 0;}
  .section-head{
    display:grid; grid-template-columns:1fr 1.6fr; gap:40px;
    border-bottom:1px solid var(--line); padding-bottom:34px; margin-bottom:48px;
    align-items:end;
  }
  .section-head .tag{color:var(--brass); font-size:0.85rem; font-weight:600;}
  .section-head h2{font-size:clamp(1.7rem,3vw,2.3rem); margin-top:10px;}
  .section-head p{color:var(--slate); max-width:52ch; margin:0;}

  /* ---------- practice areas as articles ---------- */
  .articles{border-top:1px solid var(--line);}
  .article{
    display:grid; grid-template-columns:120px 1fr 1.1fr; gap:32px;
    padding:34px 0; border-bottom:1px solid var(--line);
    align-items:start;
  }
  .article .art-no{font-family:'Fraunces',serif; color:var(--brass); font-size:1.05rem;}
  .article h3{font-size:1.28rem;}
  .article p{color:var(--slate); margin:10px 0 0; max-width:48ch;}

  /* ---------- about / firm ---------- */
  .about{background:var(--paper-dim); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
  .about .wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:64px;}
  .about h2{font-size:clamp(1.6rem,3vw,2.1rem); max-width:16ch;}
  .about-copy p{color:var(--slate); margin:0 0 18px;}
  .about-list{list-style:none; margin:28px 0 0; padding:0; display:grid; gap:16px;}
  .about-list li{display:flex; gap:14px; font-size:0.95rem;}
  .about-list li::before{content:"—"; color:var(--brass); flex:none;}

  /* ---------- team ---------- */
  .team-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .team-card{background:var(--paper); padding:32px 28px;}
  .team-card .initials{
    width:52px; height:52px; border:1px solid var(--line-dark); border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces',serif; font-size:1.05rem; color:var(--charcoal); margin-bottom:20px;
  }
  .team-card h3{font-size:1.1rem;}
  .team-card .role{color:var(--brass); font-size:0.82rem; margin:6px 0 14px;}
  .team-card p{color:var(--slate); font-size:0.92rem; margin:0;}

  /* ---------- process ---------- */
  .process{border-top:1px solid var(--line);}
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:28px;}
  .step{border-top:2px solid var(--ink); padding-top:18px;}
  .step .art-no{font-family:'Fraunces',serif; color:var(--brass); font-size:0.95rem;}
  .step h3{font-size:1.05rem; margin-top:10px;}
  .step p{color:var(--slate); font-size:0.9rem; margin:8px 0 0;}

  /* ---------- testimonial ---------- */
  .testimonial{background:var(--ink); color:var(--paper);}
  .testimonial blockquote{
    font-family:'Fraunces',serif; font-weight:400; font-size:clamp(1.3rem,2.6vw,1.8rem);
    max-width:26ch; margin:0; line-height:1.4; color:#f4f1e8;
  }
  .testimonial cite{display:block; margin-top:26px; font-style:normal; color:#cbb98a; font-size:0.92rem;}

  /* ---------- contact ---------- */
  .contact .wrap{display:grid; grid-template-columns:1fr 1fr; gap:64px;}
  .field{margin-bottom:20px;}
  .field label{display:block; font-size:0.85rem; color:var(--slate); margin-bottom:8px;}
  .field input, .field textarea, .field select{
    width:100%; border:1px solid var(--line-dark); background:transparent; color:var(--charcoal);
    padding:12px 14px; font-family:'Inter',sans-serif; font-size:0.95rem; border-radius:var(--radius);
  }
  .field textarea{resize:vertical; min-height:110px;}
  .contact-info h2{font-size:clamp(1.6rem,3vw,2.1rem); max-width:14ch;}
  .contact-line{display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding:16px 0; font-size:0.95rem;}
  .contact-line span:first-child{color:var(--slate);}
  .form-status{font-size:0.85rem; color:var(--brass); margin-top:14px; min-height:1.2em;}

  /* ---------- footer ---------- */
  footer{border-top:1px solid var(--line); padding:48px 0 36px;}
  .footer-top{display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:24px; padding-bottom:30px; border-bottom:1px solid var(--line);}
  .sign{font-family:'Fraunces',serif; font-style:italic; font-size:1.4rem; color:var(--slate);}
  .footer-bottom{display:flex; justify-content:space-between; padding-top:22px; font-size:0.82rem; color:var(--slate); flex-wrap:wrap; gap:10px;}

  @media (max-width:860px){
    .hero .wrap{grid-template-columns:1fr;}
    .hero-figure{border-left:none; border-top:1px solid #6b5327; padding-left:0; padding-top:20px;}
    .section-head{grid-template-columns:1fr;}
    .article{grid-template-columns:1fr; gap:8px;}
    .about .wrap{grid-template-columns:1fr;}
    .team-grid{grid-template-columns:1fr;}
    .steps{grid-template-columns:1fr 1fr;}
    .contact .wrap{grid-template-columns:1fr;}
    nav.links{display:none;}
    .menu-toggle{display:block;}
  }

  /* ---------- preloader ---------- */
  #preloader{
    position:fixed; inset:0; z-index:9999;
    background:#2a0d0f;
    display:flex; align-items:center; justify-content:center;
    flex-direction:column; gap:18px;
    transition:opacity .6s ease, visibility .6s ease;
  }
  #preloader.hidden{opacity:0; visibility:hidden; pointer-events:none;}
  #preloader .logo-mark{
    width:150px; height:150px; border-radius:50%;
    animation:sword-pulse 1.8s ease-in-out infinite;
  }
  @keyframes sword-pulse{
    0%,100%{transform:scale(1); opacity:1;}
    50%{transform:scale(1.05); opacity:.85;}
  }
</style>
</head>
<body>

<div id="preloader" aria-hidden="true">
  <img class="logo-mark" src="data:image/jpeg;base64," alt="Herrera Soto Abogados y Asociados">
</div>

<header>
  <div class="nav">
    <div class="brand"><img src="data:image/jpeg;base64," alt="Herrera Soto Abogados y Asociados" style="height:52px; width:auto; border-radius:6px;"></div>
    <nav class="links">
      <a href="#areas">Áreas de práctica</a>
      <a href="#despacho">El despacho</a>
      <a href="#equipo">Equipo</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <a href="https://wa.me/573160515138?text=Hola%2C%20quiero%20agendar%20una%20consulta%20con%20Herrera%20Soto" target="_blank" rel="noopener" class="btn">Escribir por WhatsApp</a>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div>
      <div class="hero-kicker">Despacho jurídico en Colombia — fundado en 2026</div>
      <h1>Cada caso se estudia como si fuera el único que llevamos.</h1>
      <p class="lede">Somos un despacho especializado en derecho civil, mercantil, laboral y penal, con sedes en Facatativá y Bogotá. Acompañamos a personas y empresas en los momentos donde una decisión legal bien tomada cambia el resultado.</p>
      <div class="hero-actions">
        <a href="https://wa.me/573160515138?text=Hola%2C%20quiero%20agendar%20una%20consulta%20con%20Herrera%20Soto" target="_blank" rel="noopener" class="btn" style="background:var(--brass); border-color:var(--brass);">Agendar por WhatsApp</a>
        <a href="#areas" class="btn-outline btn">Ver áreas de práctica</a>
      </div>
    </div>
    <div>
      <div class="hero-figure">
        <div class="num">2026</div>
        <div class="lab">año de fundación del despacho</div>
      </div>
      <div class="hero-figure">
        <div class="num">2</div>
        <div class="lab">sedes: Facatativá y Bogotá</div>
      </div>
    </div>
  </div>
</section>

<div class="strip">
  <div class="wrap">
    <div><strong>6</strong> áreas de práctica</div>
    <div><strong>2</strong> socios fundadores</div>
    <div><strong>2</strong> sedes — Facatativá y Bogotá</div>
    <div><strong>L–V</strong> 9:00–12:00 y 2:00–5:00 pm</div>
  </div>
</div>

<section id="areas" class="areas">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="tag">Áreas de práctica</div>
        <h2>En qué le podemos representar</h2>
      </div>
      <p>Trabajamos seis ramas del derecho de forma permanente. Cada una está a cargo de un socio con más de una década de experiencia específica en esa materia.</p>
    </div>
    <div class="articles">
      <div class="article">
        <div class="art-no">Art. 1</div>
        <h3>Derecho civil</h3>
        <p>Contratos, arrendamientos, reclamaciones patrimoniales, responsabilidad civil y sucesiones. Redactamos y revisamos antes de que un desacuerdo se vuelva litigio.</p>
      </div>
      <div class="article">
        <div class="art-no">Art. 2</div>
        <h3>Derecho mercantil y societario</h3>
        <p>Constitución de sociedades, fusiones y adquisiciones, contratos comerciales y asesoría corporativa continua para pymes y grupos empresariales.</p>
      </div>
      <div class="article">
        <div class="art-no">Art. 3</div>
        <h3>Derecho laboral</h3>
        <p>Despidos, negociación colectiva, auditorías de cumplimiento y defensa ante inspecciones de trabajo, tanto para empresas como para trabajadores.</p>
      </div>
      <div class="article">
        <div class="art-no">Art. 4</div>
        <h3>Derecho penal</h3>
        <p>Defensa en procesos penales económicos, delitos societarios y representación desde la primera declaración hasta la sentencia.</p>
      </div>
      <div class="article">
        <div class="art-no">Art. 5</div>
        <h3>Derecho de familia</h3>
        <p>Divorcios, custodias, régimen de visitas y acuerdos patrimoniales, con mediación previa siempre que sea posible.</p>
      </div>
      <div class="article">
        <div class="art-no">Art. 6</div>
        <h3>Propiedad intelectual</h3>
        <p>Registro de marcas y patentes, licencias, y defensa frente a infracciones de derechos de autor y competencia desleal.</p>
      </div>
    </div>
  </div>
</section>

<section class="about" id="despacho">
  <div class="wrap">
    <div>
      <div class="tag" style="color:var(--brass); font-size:0.85rem; font-weight:600;">El despacho</div>
      <h2 style="margin-top:10px;">Un despacho nuevo, con un criterio que no lo es</h2>
    </div>
    <div class="about-copy">
      <p>Herrera Soto nació en 2026, fundado por Erick Santiago Herrera Bernal y Yary Daniela Soto Sanabria con una idea simple: cada cliente merece al socio a cargo de su caso, no un equipo rotativo. Hoy atendemos desde nuestras sedes de Facatativá y Bogotá.</p>
      <p>No cobramos por hora de conversación. La primera consulta sirve para decirle con honestidad si su caso tiene fundamento, qué tiempo puede tomar y qué opciones reales existen antes de que usted decida seguir adelante.</p>
      <ul class="about-list">
        <li>Honorarios explicados por escrito antes de iniciar cualquier gestión</li>
        <li>Un solo abogado responsable de su caso, no un equipo rotativo</li>
        <li>Actualizaciones directas, sin intermediarios ni plantillas automáticas</li>
      </ul>
    </div>
  </div>
</section>

<section id="equipo">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="tag">Equipo</div>
        <h2>Los socios al frente de cada área</h2>
      </div>
      <p>Los socios fundadores del despacho.</p>
    </div>
    <div class="team-grid">
      <div class="team-card">
        <div class="initials">EH</div>
        <h3>Erick Santiago Herrera Bernal</h3>
        <div class="role">Socio fundador — Abogado corporativo</div>
      </div>
      <div class="team-card">
        <div class="initials">DS</div>
        <h3>Yary Daniela Soto Sanabria</h3>
        <div class="role">Socia fundadora — Derecho penal</div>
      </div>
    </div>
  </div>
</section>

<section class="process">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="tag">Cómo trabajamos</div>
        <h2>De la primera llamada a la resolución</h2>
      </div>
      <p>El mismo proceso para todos los casos, sin importar el tamaño.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="art-no">01</div>
        <h3>Consulta inicial</h3>
        <p>Una reunión de 45 minutos, presencial o por videollamada, para entender el caso y ver si podemos ayudar.</p>
      </div>
      <div class="step">
        <div class="art-no">02</div>
        <h3>Análisis y estrategia</h3>
        <p>El socio a cargo estudia la documentación y presenta un plan de acción con plazos y costos estimados.</p>
      </div>
      <div class="step">
        <div class="art-no">03</div>
        <h3>Representación</h3>
        <p>Gestionamos negociaciones, trámites o el proceso judicial manteniéndolo informado en cada etapa relevante.</p>
      </div>
      <div class="step">
        <div class="art-no">04</div>
        <h3>Cierre y seguimiento</h3>
        <p>Resolución del caso y una revisión posterior para confirmar que los acuerdos se cumplen.</p>
      </div>
    </div>
  </div>
</section>

<section class="testimonial">
  <div class="wrap">
    <blockquote>
      Nos explicaron desde la primera reunión qué escenarios eran realistas. Eso nos ahorró meses de indecisión y una cifra considerable en honorarios innecesarios.
      <cite>— Dirección financiera, empresa de logística, cliente desde 2019</cite>
    </blockquote>
  </div>
</section>

<section id="contacto" class="contact">
  <div class="wrap">
    <div class="contact-info">
      <div class="tag" style="color:var(--brass); font-size:0.85rem; font-weight:600;">Contacto</div>
      <h2 style="margin-top:10px;">Toda la atención es por WhatsApp</h2>
      <p style="color:var(--slate); margin-top:16px; max-width:40ch;">La primera consulta no tiene costo si su caso es viable para el despacho. Escríbanos y un abogado le responde directamente.</p>
      <div style="margin-top:32px;">
        <div class="contact-line"><span>WhatsApp</span><span>316 051 5138</span></div>
        <div class="contact-line"><span>Sede Facatativá</span><span>Atención con cita previa</span></div>
        <div class="contact-line"><span>Sede Bogotá</span><span>Atención con cita previa</span></div>
        <div class="contact-line"><span>Horario</span><span>Lun–Vie, 9:00–12:00 y 2:00–5:00 pm</span></div>
      </div>
    </div>
    <div>
      <div class="field">
        <label for="area">Área de su consulta</label>
        <select id="area" name="area">
          <option>Derecho civil</option>
          <option>Derecho mercantil y societario</option>
          <option>Derecho laboral</option>
          <option>Derecho penal</option>
          <option>Derecho de familia</option>
          <option>Propiedad intelectual</option>
          <option>Otra</option>
        </select>
      </div>
      <div class="field">
        <label for="mensaje">Cuéntenos brevemente su caso</label>
        <textarea id="mensaje" name="mensaje" placeholder="Describa la situación en pocas líneas"></textarea>
      </div>
      <a id="whatsappBtn" href="https://wa.me/573160515138?text=Hola%2C%20quiero%20una%20consulta" target="_blank" rel="noopener" class="btn" style="background:#25D366; border-color:#25D366; width:100%; text-align:center; display:block;">Continuar por WhatsApp</a>
      <div class="form-status" id="formStatus">Al hacer clic se abre WhatsApp con su mensaje ya redactado.</div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="brand"><img src="data:image/jpeg;base64," alt="Herrera Soto Abogados y Asociados" style="height:44px; width:auto; border-radius:5px;"></div>
      <div class="sign">E. Herrera &amp; D. Soto</div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Herrera Soto Abogados y Asociados. Todos los derechos reservados.</span>
      <span>Facatativá · Bogotá</span>
    </div>
  </div>
</footer>

<script>
  window.addEventListener('load', function(){
    const pre = document.getElementById('preloader');
    setTimeout(function(){
      pre.classList.add('hidden');
      setTimeout(function(){ pre.remove(); }, 700);
    }, 500);
  });
</script>
<script>
  document.getElementById('whatsappBtn').addEventListener('click', function(){
    const area = document.getElementById('area').value;
    const mensaje = document.getElementById('mensaje').value.trim();
    let texto = 'Hola, quiero una consulta sobre ' + area + '.';
    if(mensaje){ texto += ' ' + mensaje; }
    this.href = 'https://wa.me/573160515138?text=' + encodeURIComponent(texto);
  });
</script>

</body>
</html>
